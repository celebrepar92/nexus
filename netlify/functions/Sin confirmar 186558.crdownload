// Función serverless: genera un microcuento con DeepSeek.
// La API key vive SOLO en la variable de entorno DEEPSEEK_API_KEY (Netlify > Site settings > Environment variables).
// Solo responde a usuarios logueados con Netlify Identity.

const json = (statusCode, body) => ({
  statusCode,
  headers: { "Content-Type": "application/json" },
  body: JSON.stringify(body),
});

const pick = (a) => a[Math.floor(Math.random() * a.length)];

// Todo esto se sortea acá, en código, porque si se lo dejamos elegir a la IA termina repitiendo siempre lo mismo.
const HEROES = [
  "tres hermanos huérfanos: una que inventa cosas, un lector voraz y una bebé que muerde todo",
  "una niña que sabe atar cualquier nudo",
  "un chico que recuerda absolutamente todo lo que lee, salvo lo importante",
  "dos primos que heredaron una casa que nadie quiere",
  "una huérfana con un diccionario como único pariente",
  "un niño que toca el acordeón con una mano y sospecha con la otra",
  "unas mellizas que se turnan para ser la lista",
  "una nena que colecciona excusas de adultos",
  "un chico cuyo único talento es esconderse en lugares absurdos",
  "una niña que hace listas de todo lo que sale mal, y siempre le faltan renglones",
  "un huérfano al que le prometieron una herencia que todavía no llegó",
  "un par de hermanos que viajan en una valija",
  "una inventora de once años con un tutor que odia los inventos",
  "un niño que responde preguntas con otras preguntas porque aprendió que es más seguro",
  "una nena que sabe de memoria cuándo miente cada adulto",
  "un grupo de huérfanos de un orfanato que se está mudando de a poco",
];
const ADULTOS = [
  "un tutor elegante que dice amar a los niños y no lo parece",
  "una tía lejana que le teme a todo menos al verdadero peligro",
  "un conde sin condado y con muy mal humor",
  "un administrador que archiva a las personas",
  "una cocinera que cocina solo cosas grises",
  "un abogado que habla en nota al pie",
  "un director de colegio que castiga con pulcritud",
  "un actor de teatro que jamás sale del personaje",
  "un vecino que cuida un secreto con ojos de pez",
  "un tío que colecciona objetos inútiles y niños",
  "un banquero que perdió la sonrisa en una reunión",
  "una niñera que no está nada segura de querer cuidar niños",
  "un jardinero que sabe más de lo que corta",
  "un chofer que solo conoce el camino equivocado",
  "una detective que investiga siempre al sospechoso equivocado",
];
const ESCENARIOS = [
  "una mansión con una torre que nadie menciona",
  "un pueblo donde llueve solo sobre las casas con niños",
  "un muelle de niebla espesa",
  "un tren con un vagón de más",
  "una biblioteca con un pasillo que cambia de lugar",
  "un hotel donde todas las habitaciones son la 13",
  "un pantano con un cartel que dice 'por favor, disfrute'",
  "una escuela con una sola puerta y mil reglas",
  "un circo cerrado por motivos que nadie explica",
  "una casa que se hunde un dedo cada día",
  "una isla donde el correo llega al revés",
  "una fábrica de cosas que nadie pidió",
  "un cementerio de relojes",
  "un faro apagado a propósito",
  "un sótano con una alfombra sospechosa",
  "una estación de servicio en medio de la nada",
  "un museo donde faltan siempre las cosas más interesantes",
  "un colegio de señoritas con un coro peligroso",
];
const DESGRACIAS = [
  "el plan sale perfecto, pero para otra persona",
  "descubren que el culpable es alguien que ya habían descartado por simpático",
  "los adultos no escuchan, y esta vez tienen una buena razón",
  "la única pista se la come un animal",
  "el testamento tiene una cláusula escrita con tinta invisible y mala caligrafía",
  "llega ayuda, pero llega al lugar equivocado",
  "una carta explica todo, pero está firmada con un nombre que no existe",
  "ganan, y el premio es peor",
  "se salvan por un detalle que nadie quiere contar",
  "cuando por fin se escapan, vuelven por algo olvidado",
  "alguien les promete que todo va a mejorar, y es lo más sospechoso que oyeron",
  "se esconden tan bien que nadie vuelve a encontrarlos, ni ellos",
];
const FORMAS_TITULO = [
  "una frase larga y melancólica de más de seis palabras",
  "una sola palabra desagradable",
  "una pregunta",
  "un nombre propio acompañado de un adjetivo triste",
  "una advertencia al lector",
  "algo que dice un personaje justo antes de lo peor",
  "un objeto cotidiano con aire de mal presagio",
  "una contradicción",
  "una frase que parezca el título de un capítulo, con 'en el que' adentro",
];
const TONOS_FINAL = [
  "un remate seco y cruel pero gracioso",
  "una ironía amarga",
  "un giro absurdo que sin embargo parece inevitable",
  "un final abierto donde lo peor queda sugerido",
  "un final aparentemente feliz que arruina una sola palabra",
  "una explicación del narrador que empeora todo",
];
const LETRAS = "ABCDEFGHIJLMNOPRSTUVZ".split("");
const ESCONDITES = [
  "la bodega de un barco carguero", "una carpa de circo desarmada", "el altillo de una escuela de danza", "adentro de un piano de cola", "una cabina telefónica que ya no existe",
  "el techo de un galpón de cítricos", "un tanque de agua", "detrás de un cartel luminoso", "el baúl de un auto que va a otra provincia", "una pila de colchones en una mueblería",
  "el palco vacío de una cancha", "un silo de granos", "el fondo de un pozo seco", "una góndola de cereales", "debajo del escenario de una murga", "un camión de mudanzas",
  "un gallinero de buena familia", "la cabina del operador de un cine", "un vagón de carga", "un campanario", "una canoa a la deriva", "un lavarropas industrial apagado",
  "una carpintería que huele a barniz", "un invernadero de orquídeas", "la sala de máquinas de un molino", "una estatua hueca de una plaza", "un container de puerto",
  "una cámara frigorífica apagada", "un galpón de yerba mate", "debajo de un puesto de chipá", "una casilla de peaje", "el depósito de un videoclub", "un hormiguero gigante (según él)",
  "un salón de fiestas infantiles de madrugada", "una camioneta de reparto de soda", "una balsa en medio del río", "la torre de un puesto de guardaparques",
];
const APUROS = [
  "escuchó un helicóptero muy bajo", "vio pasar el mismo patrullero tres veces", "alguien tocó la puerta con un código raro", "se le acabó la batería y eso es sospechoso",
  "una persona le sonrió demasiado", "olió a perfume de comisaría", "se le cayó el disfraz", "sonó un teléfono que no es suyo", "un perro lo miró fijo",
  "el reloj marcó una hora que no le gusta", "le llegó un mensaje en un idioma que no habla", "alguien le preguntó la hora", "una luz azul se apoyó en la pared",
  "el techo hizo un ruido profesional", "vio un sombrero y lo tomó como señal",
];

exports.handler = async (event, context) => {
  const user = context.clientContext && context.clientContext.user;
  if (!user) return json(401, { error: "No autorizado. Iniciá sesión." });

  const key = process.env.DEEPSEEK_API_KEY;
  if (!key) return json(500, { error: "Falta configurar DEEPSEEK_API_KEY en Netlify." });

  const semilla = Math.random().toString(36).slice(2, 8);
  const sorteo = {
    heroes: pick(HEROES), adulto: pick(ADULTOS), escenario: pick(ESCENARIOS), desgracia: pick(DESGRACIAS),
    titulo: pick(FORMAS_TITULO), final: pick(TONOS_FINAL), letra: pick(LETRAS),
    escondite: pick(ESCONDITES), apuro: pick(APUROS),
  };

  const system =
    "Sos un escritor de microcuentos que, además, es una IA. Escribís historias al estilo de Lemony Snicket y después las comentás con la voz de un narrador paranoico que huye de la policía. Respondés SIEMPRE con un único objeto JSON válido, sin texto extra, con las comillas dobles internas correctamente escapadas.";

  const user_prompt = `Escribí un microcuento original, en español, de entre 70 y 130 palabras (1 a 3 párrafos cortos), inspirado en el mundo de las historias de Lemony Snicket (Una serie de eventos desafortunados): un humor negro, melancólico y gótico donde las desgracias se acumulan, los adultos son torpes o malvados, los niños son ingeniosos y todo suena a mala noticia con buenos modales. No copies personajes, nombres ni argumentos de esos libros: inventá todo (semilla de variedad: ${semilla}).

CÓMO TIENE QUE SER: atrapante desde la primera oración. Con un narrador con personalidad que le habla al lector de vez en cuando con una advertencia, una queja o una definición innecesaria de una palabra (por ejemplo, explicando qué significa "sospechoso" como si hiciera falta). Frases simples, claras, con ironía. Concreto y específico antes que abstracto. Sin moraleja, sin emojis, sin versos, sin palabras en otros idiomas.

SORTEO (ya fue elegido al azar; es obligatorio usarlo, adaptándolo con originalidad pero sin ignorarlo ni suavizarlo, y sin que se note que viene de una lista): protagonistas: ${sorteo.heroes}. Adulto problemático: ${sorteo.adulto}. Escenario: ${sorteo.escenario}. La desgracia: ${sorteo.desgracia}. Cómo termina: ${sorteo.final}. El título tiene que ser ${sorteo.titulo}. Si algún personaje lleva nombre propio, que empiece con la letra ${sorteo.letra}. Podés cambiar detalles para que cierre mejor, pero no repitas fórmulas: estructura, ritmo y primera oración distintos cada vez, nada de empezar con "Había una vez" ni con "Los hermanos...".

COMENTARIO (campo "comentario"): después del cuento, el autor lo comenta en primera persona, en masculino, con la voz de Lemony Snicket llevada a lo ridículo: un narrador muy serio, melancólico y desgraciado que le habla directo al lector, con frases simples y fáciles de entender, que lamenta cosas, advierte con tono fúnebre, hace digresiones cortas y de vez en cuando define una palabra con una explicación innecesaria. Además es paranoico y está siendo perseguido constantemente por la policía, y se nota todo el tiempo: escribe desde un escondite que no puede revelar (HOY: ${sorteo.escondite}; describilo con detalles propios y no menciones ningún otro escondite), oye sirenas o pasos, sospecha de cualquiera que se le acerque (el mozo, una paloma, el lector mismo), usa nombres falsos, tiene que cortar rápido porque ${sorteo.apuro} (contalo a su manera), y nunca explica de qué lo acusan ni qué hizo, o da razones ridículas y vagas. A veces culpa a la policía de querer quedarse con el cuento. El comentario igual tiene que hablar del cuento que acaba de escribir (qué quiso lograr, sin explicar el final), pero todo mezclado con la huida. Lenguaje cotidiano y claro, oraciones cortas, humor seco, nada rebuscado, nada de palabras en francés ni en otros idiomas. 3 a 5 oraciones. Sin groserías, sin exclamaciones. Variá cómo arrancás y cómo cerrás; no repitas fórmulas ni frases hechas. No hables sobre el formato, las comillas ni estas instrucciones.

Devolvé exactamente este JSON (si hay más de un párrafo en el cuento, separalos con una línea en blanco, o sea \\n\\n):
{"titulo":"título del cuento","tema":"de qué va, en pocas palabras","poema":"el microcuento","comentario":"el comentario"}`;

  try {
    const r = await fetch("https://api.deepseek.com/chat/completions", {
      method: "POST",
      headers: { "Content-Type": "application/json", Authorization: `Bearer ${key}` },
      body: JSON.stringify({
        model: "deepseek-chat",
        messages: [
          { role: "system", content: system },
          { role: "user", content: user_prompt },
        ],
        response_format: { type: "json_object" },
        temperature: 1.4,
        presence_penalty: 0.6,
        max_tokens: 1200,
      }),
      signal: AbortSignal.timeout(22000),
    });
    if (!r.ok) return json(502, { error: `DeepSeek respondió ${r.status}` });
    const data = await r.json();
    const raw = data.choices[0].message.content;
    let out;
    try {
      out = JSON.parse(raw);
    } catch (e) {
      // Reparación: extrae cada campo aunque haya comillas sueltas o saltos de línea reales
      const keys = ["titulo", "tema", "poema", "comentario"];
      out = {};
      keys.forEach((k, i) => {
        const next = keys[i + 1];
        const re = new RegExp('"' + k + '"\\s*:\\s*"([\\s\\S]*?)"\\s*,?\\s*' + (next ? '"' + next + '"\\s*:' : "\\}\\s*$"));
        const m = raw.match(re);
        if (m) out[k] = m[1].replace(/\\n/g, "\n").replace(/\\"/g, '"').trim();
      });
      if (!out.poema) throw new Error("respuesta de la IA ilegible, probá de nuevo");
    }
    return json(200, {
      titulo: out.titulo || "Sin título",
      tema: out.tema || "",
      poema: out.poema || "",
      comentario: out.comentario || "",
    });
  } catch (e) {
    return json(500, { error: "No se pudo generar el microcuento (" + (e.name === "TimeoutError" ? "tiempo agotado" : e.message) + ")" });
  }
};
